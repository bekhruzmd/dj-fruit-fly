{
  "name": "fruit-fly-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "test:snn": ".venv-snn/bin/python -m unittest discover -s tests -p \"test_snn_dj.py\" -v",
    "train:snn": ".venv-snn/bin/python -m snn_dj",
    "test:browser": "node scripts/browser-check.mjs",
    "analysis": ".venv/bin/python -m analysis.server",
    "test:analysis": ".venv/bin/python -m unittest discover -s tests -p \"test_analysis.py\"",
    "test:analysis:browser": "node scripts/analysis-browser-check.mjs",
    "lesson-builder": ".venv/bin/python -m lesson_builder.server",
    "test:lesson": ".venv/bin/python -m unittest discover -s tests -p \"test_lesson_builder.py\" -v",
    "test:lesson-loader": ".venv-snn/bin/python -m unittest discover -s tests -p \"test_lesson_loader.py\" -v",
    "lesson:example": ".venv/bin/python scripts/make-lesson-example.py",
    "bridge": ".venv/bin/python scripts/djay_bridge.py"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
